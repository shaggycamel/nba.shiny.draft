FROM shaggycamel/scs.nba.fty.league_draft:latest

EXPOSE 7860

# The base image already provides the non-root `rstudio` user (UID 1000),
# which is the user HuggingFace Spaces expects. No need to create one.
USER rstudio

CMD ["R", "-e", "options('shiny.port'=7860, shiny.host='0.0.0.0'); library(draft); draft::run_app()"]

# This is the HuggingFace Space Dockerfile. It lives in its own repo (cloned
# from the HuggingFace GitHub org), stored here only as a template. Copy it
# across into the space repo when needed. For a per-customer space, point FROM
# at that customer's image, e.g. shaggycamel/scs.nba.fty.league_draft:latest.
